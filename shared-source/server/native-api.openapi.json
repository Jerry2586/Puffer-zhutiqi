{
  "openapi": "3.1.0",
  "info": {
    "title": "河豚统一客户端 API",
    "version": "1.0.0",
    "description": "运营网关的既有 JSON 接口。原生客户端按设备 platform 使用主题。登录接口在本机主题服务中不开放。会员支付、DRM 与任意第三方解析器不在本规范范围内。"
  },
  "paths": {
    "/api/theme": {
      "get": {
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThemeResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求失败；按 HTTP 状态处理，401 表示会话无效，403 表示无权限，404 表示资源或功能不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "请求失败；按 HTTP 状态处理，401 表示会话无效，403 表示无权限，404 表示资源或功能不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "请求失败；按 HTTP 状态处理，401 表示会话无效，403 表示无权限，404 表示资源或功能不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "请求失败；按 HTTP 状态处理，401 表示会话无效，403 表示无权限，404 表示资源或功能不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "请求失败；按 HTTP 状态处理，401 表示会话无效，403 表示无权限，404 表示资源或功能不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "mobile",
                "tablet",
                "tv",
                "web"
              ],
              "default": "mobile"
            }
          }
        ]
      }
    },
    "/api/catalog/categories": {
